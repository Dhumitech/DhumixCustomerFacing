# Copy this file to .env for local development. Never put real values here.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dhumi_dev

# These are restricted LOGIN roles. They are not postgres or dhumi_owner.
DATABASE_IDENTITY_USER=dhumi_dev_identity_login
DATABASE_IDENTITY_PASSWORD=
DATABASE_CUSTOMER_API_USER=dhumi_dev_customer_api_login
DATABASE_CUSTOMER_API_PASSWORD=
DATABASE_ADMISSION_USER=dhumi_dev_admission_login
DATABASE_ADMISSION_PASSWORD=

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Local development uses disable. Production must use verify-full and a CA file.
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=

# Approved legal documents as a JSON array. Empty is allowed in development
# only. Production refuses to start while this is empty, because an empty
# catalogue records consent that cannot be proven against approved text.
# Real document versions and content hashes come from approved legal text and
# must never be invented. Every distinct document_type listed here becomes a
# document the customer must accept at signup.
# Example shape (values below are placeholders, not approved documents):
# LEGAL_DOCUMENTS=[{"document_type":"terms","document_version":"2026-01-01","content_hash":"<64 hex characters>"}]
LEGAL_DOCUMENTS=[]
LEGAL_DISCLOSURE_VERSION=

# Argon2id cost. 19456 KiB / 2 / 1 is the accepted baseline and is enforced as
# a floor; configuration may raise the cost but never lower it. Measured at
# about 22.5 ms per hash on the local development machine.
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_PARALLELISM=1

# Demo environment configuration, NOT an approved platform limit. Published
# limits stay PENDING-VERIFICATION until signed rate evidence and load tests
# exist. Derived from measured capacity: about 178 hashes per second across the
# default four libuv threads, so 5 attempts per 15 minutes per caller keeps a
# hostile source far below the hashing ceiling.
SIGNUP_RATE_LIMIT_MAX=5
SIGNUP_RATE_LIMIT_WINDOW_MS=900000

# Browser session. ACCESS_TOKEN_SECRET signs the short-lived access token and
# derives the CSRF value; it must come from the environment or a secret manager
# and never be committed. Generate at least 32 characters of randomness, for
# example:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=https://api.dhumi.example
ACCESS_TOKEN_AUDIENCE=dhumi-browser
ACCESS_TOKEN_TTL_SECONDS=900
# auth_sessions carries CHECK (expires_at > issued_at); this must be positive.
REFRESH_TOKEN_TTL_SECONDS=1209600

SESSION_COOKIE_NAME=dhumi_refresh
SESSION_COOKIE_SAMESITE=strict
SESSION_COOKIE_PATH=/v1/auth
SESSION_COOKIE_DOMAIN=

# Demo environment configuration, NOT approved platform limits. Sign-in shares
# the Argon2 threadpool with signup, so this comes out of the same budget.
SIGNIN_RATE_LIMIT_MAX=10
SIGNIN_RATE_LIMIT_WINDOW_MS=900000
# Refresh performs no password hashing, but both the source IP and a safe hash
# of the cookie receive bounded demo buckets. These are not published limits.
REFRESH_RATE_LIMIT_MAX=30
REFRESH_RATE_LIMIT_WINDOW_MS=900000
# Lockout timings are PENDING-VERIFICATION in Project Specs 05_Security/01.
SIGNIN_LOCKOUT_THRESHOLD=10
SIGNIN_LOCKOUT_WINDOW_MS=900000

# Local/test worker secret adapter only. Never inject this value into a
# production Customer API; production uses the managed secret provider.
BRIGHTDATA_API_KEY=

# Pattern 3 local result boundary. Keep unavailable unless Azurite is running.
# The connection string is private configuration even when it targets the
# emulator; do not commit its value. Production must not use this adapter.
RESULT_STORAGE_DRIVER=unavailable
RESULT_STORAGE_CONNECTION_STRING=
RESULT_STORAGE_CONTAINER=dhumi-results
RESULT_DOWNLOAD_TTL_SECONDS=300
RESULT_MAX_BYTES=104857600
MARKETPLACE_SAMPLE_DOWNLOAD_MAX_RECORDS=100
MARKETPLACE_SAMPLE_DOWNLOAD_MAX_BYTES=1048576
MARKETPLACE_SAMPLE_DOWNLOAD_RATE_LIMIT_MAX=10
MARKETPLACE_SAMPLE_DOWNLOAD_RATE_WINDOW_SECONDS=3600
# Generated sample-download copies (not 30-day source samples): migration 0064
# permits immediate failed-object cleanup and expiry + 1 hour retention cleanup.
# Schedule the private operator:marketplace-download-cleanup command separately;
# deploying the API alone does not recover process-crash leftovers.

# Worker-only result-recorder credential. Do not inject this pair into the
# Fastify API deployment. Create it with bootstrap/0008 and supply it only to
# the private result-recorder/Job Manager process.
DATABASE_RESULT_RECORDER_USER=dhumi_dev_result_recorder_login
DATABASE_RESULT_RECORDER_PASSWORD=

# Pattern 4 local durable execution workers. Production forbids these local
# emulator connection settings and requires managed Azure workload identity.
DATABASE_OUTBOX_DISPATCHER_USER=dhumi_dev_outbox_dispatcher_login
DATABASE_OUTBOX_DISPATCHER_PASSWORD=
DATABASE_JOB_MANAGER_USER=dhumi_dev_job_manager_login
DATABASE_JOB_MANAGER_PASSWORD=
# Used only by the explicit one-command DLQ recovery CLI. Never inject this
# broad operator credential into the API, dispatcher or Job Manager process.
DATABASE_OPERATOR_USER=dhumi_dev_operator_login
DATABASE_OPERATOR_PASSWORD=
SERVICE_BUS_DRIVER=emulator
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SERVICE_BUS_RUN_COMMAND_QUEUE=dhumi-run-commands
OUTBOX_DISPATCHER_ID=local-dispatcher-1
OUTBOX_DISPATCHER_BATCH_SIZE=20
OUTBOX_DISPATCHER_INTERVAL_MS=1000
OUTBOX_DISPATCHER_CLAIM_TTL_MS=60000
JOB_MANAGER_CONCURRENCY=2
JOB_MANAGER_ATTEMPT_LEASE_MS=60000
JOB_MANAGER_RENEW_INTERVAL_MS=20000
REDIS_URL=redis://127.0.0.1:6380
REDIS_LEASE_PREFIX=dhumi:run-capacity
REDIS_CAPACITY_LEASE_MS=60000

# Pattern 5 private executor. Keep `controlled` for synthetic Pattern 4 runs.
# `bright_data` is local-development only until the Azure Key Vault/managed-key
# adapter is deployed. Generate a separate 32-byte base64url protector key; do
# not reuse ACCESS_TOKEN_SECRET.
RUN_EXECUTOR_DRIVER=controlled
PROVIDER_SECRET_DRIVER=environment
PROVIDER_REFERENCE_LOCAL_KEY=
BRIGHTDATA_REQUEST_TIMEOUT_MS=120000
BRIGHTDATA_CONTROL_RESPONSE_MAX_BYTES=1048576
# Operator-only scraper catalogue ceiling. Keep equal to the small-control
# ceiling until an observed Content-Length supports a finite increase. It must
# remain between BRIGHTDATA_CONTROL_RESPONSE_MAX_BYTES and RESULT_MAX_BYTES.
BRIGHTDATA_CATALOGUE_RESPONSE_MAX_BYTES=1048576
BRIGHTDATA_POLL_INTERVAL_MS=2000
BRIGHTDATA_POLL_MAX_ELAPSED_MS=900000
# Dhumi read-failure policy, not a provider limit; preserved across recovery.
BRIGHTDATA_POLL_MAX_CONSECUTIVE_FAILURES=5

# 0071 organization email/proof settings, required only at the coordinated cutover.
# Enter independent secrets when activation is approved; these are blank holders.
APP_ENVIRONMENT=local
APP_PUBLIC_URL=http://localhost:5173
EMAIL_DRIVER=file
EMAIL_FROM=notifications@example.test
OTP_SECRET=
# Resend ensures at least this many days remain, without shortening a later expiry.
# Creating an invitation still uses the request's explicit expires_at.
ORGANIZATION_INVITE_RESEND_LIFETIME_DAYS=7
# For shared/production use EMAIL_DRIVER=acs and an HTTPS APP_PUBLIC_URL.
ACS_EMAIL_ENDPOINT=
ACS_EMAIL_ACCESS_KEY=
