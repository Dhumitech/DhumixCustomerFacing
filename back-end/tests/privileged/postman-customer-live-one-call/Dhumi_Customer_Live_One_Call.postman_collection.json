  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 — Authenticated Amazon Run — ONE BILLABLE CALL",
      "description": "Run this folder only. One authenticated Run POST produces exactly one provider scrape submission for one Amazon product URL.",
