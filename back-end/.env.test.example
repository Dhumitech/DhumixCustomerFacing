# Copy this file to .env.test for the restricted database integration test.
# Never commit .env.test or place real passwords in this example.
NODE_ENV=test
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=silent
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dhumi_test

# Create these restricted LOGIN roles manually with bootstrap/0004.
# Use two different generated passwords of at least 20 characters. The values
# in this local file must exactly match the passwords assigned in PostgreSQL.
DATABASE_IDENTITY_USER=dhumi_test_identity_login
DATABASE_IDENTITY_PASSWORD=
DATABASE_CUSTOMER_API_USER=dhumi_test_customer_api_login
DATABASE_CUSTOMER_API_PASSWORD=
DATABASE_ADMISSION_USER=dhumi_test_admission_login
DATABASE_ADMISSION_PASSWORD=
DATABASE_ENVELOPE_JANITOR_USER=dhumi_test_envelope_janitor_login
DATABASE_ENVELOPE_JANITOR_PASSWORD=
ENVELOPE_JANITOR_INTERVAL_MS=5000
ENVELOPE_JANITOR_BATCH_SIZE=100

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=

RUN_DATABASE_INTEGRATION_TESTS=true

# Empty catalogue is intentional for tests. Production refuses to start empty.
LEGAL_DOCUMENTS=[]
LEGAL_DISCLOSURE_VERSION=

# Accepted Argon2id baseline. These are enforced floors and cannot be lowered
# to speed tests up.
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_PARALLELISM=1

# Demo environment configuration, not an approved platform limit.
SIGNUP_RATE_LIMIT_MAX=5
SIGNUP_RATE_LIMIT_WINDOW_MS=900000

# Browser session. ACCESS_TOKEN_SECRET signs the short-lived access token and
# derives the CSRF value; it must come from the environment or a secret manager
# and never be committed. Generate at least 32 characters of randomness, for
# example:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=https://api.dhumi.example
ACCESS_TOKEN_AUDIENCE=dhumi-browser
ACCESS_TOKEN_TTL_SECONDS=900
# Separate 32-byte test-only envelope root (43 unpadded base64url characters).
RESPONSE_ENVELOPE_LOCAL_KEY=
# auth_sessions carries CHECK (expires_at > issued_at); this must be positive.
REFRESH_TOKEN_TTL_SECONDS=1209600

SESSION_COOKIE_NAME=dhumi_refresh
SESSION_COOKIE_SAMESITE=strict
SESSION_COOKIE_PATH=/v1/auth
SESSION_COOKIE_DOMAIN=

# Demo environment configuration, NOT approved platform limits. Sign-in shares
# the Argon2 threadpool with signup, so this comes out of the same budget.
SIGNIN_RATE_LIMIT_MAX=10
SIGNIN_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=30
REFRESH_RATE_LIMIT_WINDOW_MS=900000
# Lockout timings are PENDING-VERIFICATION in Project Specs 05_Security/01.
SIGNIN_LOCKOUT_THRESHOLD=10
SIGNIN_LOCKOUT_WINDOW_MS=900000

# Local/test worker secret adapter only; leave empty for offline suites.
BRIGHTDATA_API_KEY=

# Pattern 3 Azurite integration remains opt-in and uses synthetic bytes only.
RESULT_STORAGE_DRIVER=unavailable
RESULT_STORAGE_CONNECTION_STRING=
RESULT_STORAGE_CONTAINER=dhumi-test-results
RESULT_DOWNLOAD_TTL_SECONDS=300
RESULT_MAX_BYTES=104857600
RUN_AZURITE_INTEGRATION_TESTS=false

DATABASE_RESULT_RECORDER_USER=dhumi_test_result_recorder_login
DATABASE_RESULT_RECORDER_PASSWORD=

# Pattern 4 local durable execution workers.
DATABASE_OUTBOX_DISPATCHER_USER=dhumi_test_outbox_dispatcher_login
DATABASE_OUTBOX_DISPATCHER_PASSWORD=
DATABASE_JOB_MANAGER_USER=dhumi_test_job_manager_login
DATABASE_JOB_MANAGER_PASSWORD=
DATABASE_OPERATOR_USER=dhumi_test_operator_login
DATABASE_OPERATOR_PASSWORD=
SERVICE_BUS_DRIVER=emulator
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SERVICE_BUS_RUN_COMMAND_QUEUE=dhumi-run-commands
OUTBOX_DISPATCHER_ID=test-dispatcher-1
OUTBOX_DISPATCHER_BATCH_SIZE=20
OUTBOX_DISPATCHER_INTERVAL_MS=100
OUTBOX_DISPATCHER_CLAIM_TTL_MS=5000
JOB_MANAGER_CONCURRENCY=2
JOB_MANAGER_ATTEMPT_LEASE_MS=15000
JOB_MANAGER_RENEW_INTERVAL_MS=5000
REDIS_URL=redis://127.0.0.1:6380
REDIS_LEASE_PREFIX=dhumi:test:run-capacity
REDIS_CAPACITY_LEASE_MS=15000

# Pattern 5 remains transport-stubbed unless an explicitly authorized local
# fixture selects the private worker. Never put a production provider key here.
RUN_EXECUTOR_DRIVER=controlled
PROVIDER_SECRET_DRIVER=environment
PROVIDER_REFERENCE_LOCAL_KEY=
BRIGHTDATA_REQUEST_TIMEOUT_MS=5000
BRIGHTDATA_CONTROL_RESPONSE_MAX_BYTES=1048576
# Tests default this to the small-control ceiling; larger values require an
# explicit bounded-catalogue test and may not exceed RESULT_MAX_BYTES.
BRIGHTDATA_CATALOGUE_RESPONSE_MAX_BYTES=1048576
BRIGHTDATA_POLL_INTERVAL_MS=100
BRIGHTDATA_POLL_MAX_ELAPSED_MS=5000
BRIGHTDATA_POLL_MAX_CONSECUTIVE_FAILURES=5
