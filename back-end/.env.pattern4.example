# Local-only Docker settings. Change N to Y only after reviewing and accepting
# the Service Bus emulator and SQL Server Linux license terms.
PATTERN4_ACCEPT_EULA=N
PATTERN4_MSSQL_SA_PASSWORD=
PATTERN4_REDIS_PORT=6380

# Worker runtime values belong in .env or a process-specific ignored env file.
SERVICE_BUS_DRIVER=emulator
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SERVICE_BUS_RUN_COMMAND_QUEUE=dhumi-run-commands
REDIS_URL=redis://127.0.0.1:6380
