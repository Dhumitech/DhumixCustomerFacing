# Deployment environment template. Real values belong only in private back-end/.env.azure.
# Owner-approved demo mode, not NODE_ENV=production. SQL/Blob/queue/Redis are ready; hosting remains pending.
# Supply the inline public CA and credentials privately; set the frontend origin for the chosen host.

# Azure demo deployment -- explicit no-OTP release
APP_ENVIRONMENT='shared_dev'
APP_PUBLIC_URL=''
DEMO_DISABLE_OTP='true'
FRONTEND_ORIGIN=''
HOST='0.0.0.0'
LOG_LEVEL='info'
NODE_ENV='test'
ORGANIZATION_COLLABORATION_ENABLED='false'
PORT='3000'
TRUST_PROXY_HOPS='0'
TZ='UTC'

# Azure PostgreSQL app only -- shared database, verified TLS, existing passwords
DATABASE_ADMISSION_PASSWORD=''
DATABASE_ADMISSION_USER='dhumi_test_admission_login'
DATABASE_CONNECTION_TIMEOUT_MS='5000'
DATABASE_CUSTOMER_API_PASSWORD=''
DATABASE_CUSTOMER_API_USER='dhumi_test_customer_api_login'
DATABASE_HOST='20.244.41.57'
DATABASE_IDENTITY_PASSWORD=''
DATABASE_IDENTITY_USER='dhumi_test_identity_login'
DATABASE_IDLE_TIMEOUT_MS='30000'
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS='30000'
DATABASE_JOB_MANAGER_PASSWORD=''
DATABASE_JOB_MANAGER_USER='dhumi_test_job_manager_login'
DATABASE_NAME='dhumi_shared'
DATABASE_OUTBOX_DISPATCHER_PASSWORD=''
DATABASE_OUTBOX_DISPATCHER_USER='dhumi_test_outbox_dispatcher_login'
DATABASE_POOL_MAX='2'
DATABASE_POOL_MIN='0'
DATABASE_PORT='5432'
DATABASE_QUERY_TIMEOUT_MS='20000'
DATABASE_RESULT_RECORDER_PASSWORD=''
DATABASE_RESULT_RECORDER_USER='dhumi_test_result_recorder_login'
# Fill with base64 of the retained public CA PEM; no certificate-file setup is required.
DATABASE_SSL_CA_BASE64=''
# Alternative only: unset the inline value and set an absolute DATABASE_SSL_CA_FILE.
DATABASE_SSL_MODE='verify-full'
DATABASE_STATEMENT_TIMEOUT_MS='15000'

# Browser authentication, validation and legal settings -- API only
ACCESS_TOKEN_AUDIENCE='dhumi-browser'
ACCESS_TOKEN_ISSUER='https://dhumi.test'
ACCESS_TOKEN_SECRET=''
ACCESS_TOKEN_TTL_SECONDS='900'
REFRESH_TOKEN_TTL_SECONDS='1209600'
SESSION_COOKIE_DOMAIN=''
SESSION_COOKIE_NAME='dhumi_refresh'
SESSION_COOKIE_PATH='/v1/auth'
SESSION_COOKIE_SAMESITE='strict'
SIGNIN_LOCKOUT_THRESHOLD='10'
SIGNIN_LOCKOUT_WINDOW_MS='900000'
SIGNIN_RATE_LIMIT_MAX='50'
SIGNIN_RATE_LIMIT_WINDOW_MS='60000'
SIGNUP_RATE_LIMIT_MAX='50'
SIGNUP_RATE_LIMIT_WINDOW_MS='60000'

# Real Azure Blob Storage -- API and Job Manager only
AZURE_CLIENT_ID='b6b207a3-597c-4b1c-b21a-eab551de57bb'
AZURE_CLIENT_SECRET=''
AZURE_STORAGE_ACCOUNT_NAME='stdhumici01'
AZURE_TENANT_ID='ff680843-f718-4c4c-ae1f-af96a282d0c9'
RESULT_DOWNLOAD_PROXY_URL=''
RESULT_DOWNLOAD_TTL_SECONDS='300'
RESULT_MAX_BYTES='104857600'
RESULT_STORAGE_CONNECTION_STRING=''
RESULT_STORAGE_CONTAINER='dhumi-results'
RESULT_STORAGE_DRIVER='azure_blob'

# Command queue and dispatcher -- Azure Service Bus
OUTBOX_DISPATCHER_BATCH_SIZE='20'
OUTBOX_DISPATCHER_CLAIM_TTL_MS='5000'
OUTBOX_DISPATCHER_ID='dhumi-local-demo'
