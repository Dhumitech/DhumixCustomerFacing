# Job Manager and capacity -- secured Azure Managed Redis
JOB_MANAGER_ATTEMPT_LEASE_MS='15000'
JOB_MANAGER_CONCURRENCY='2'
JOB_MANAGER_RENEW_INTERVAL_MS='5000'
REDIS_CAPACITY_LEASE_MS='15000'
REDIS_LEASE_PREFIX='dhumi:run-capacity'
# Fill privately: authenticated rediss URL for redis-dhumi-ci-01.centralindia.redis.azure.net:10000
REDIS_URL=''

# Existing real provider binding -- Job Manager only; preserve the reference key
BRIGHTDATA_API_KEY=''
PROVIDER_REFERENCE_LOCAL_KEY=''
PROVIDER_SECRET_DRIVER='environment'
RUN_EXECUTOR_DRIVER='bright_data'
SHARED_SCRAPER_PIPELINE_ENABLED='false'

# Azure Service Bus -- portable, queue-scoped sender/receiver credentials
