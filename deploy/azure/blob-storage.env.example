# Azure Blob configuration fragment for the backend API and Job Manager.
# Merge with the backend's database/auth/queue/provider environment. This is
# not a complete application environment and never belongs in the frontend.
RESULT_STORAGE_DRIVER=azure_blob
RESULT_STORAGE_CONTAINER=dhumi-results
RESULT_STORAGE_CONNECTION_STRING=
RESULT_DOWNLOAD_PROXY_URL=
RESULT_DOWNLOAD_TTL_SECONDS=300
RESULT_MAX_BYTES=104857600
AZURE_STORAGE_ACCOUNT_NAME=stdhumici01
AZURE_TENANT_ID=ff680843-f718-4c4c-ae1f-af96a282d0c9
AZURE_CLIENT_ID=b6b207a3-597c-4b1c-b21a-eab551de57bb
# Obtain this privately from the owner. Never commit a filled example.
AZURE_CLIENT_SECRET=
